{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": ["src/**", "tests/**", "e2e/**"]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noReactPropAssignments": "error"
			},
			"style": {
				"useBlockStatements": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"react": {
								"importNames": ["useState", "useReducer", "useContext"],
								"message": "Do not use useState/useReducer/useContext, plese use src/useStore"
							}
						}
					}
				}
			},
			"performance": {
				"noNamespaceImport": "error"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
