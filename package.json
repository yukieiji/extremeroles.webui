{
  "name": "extremeroles.webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_USE_MOCK=true vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "preview": "vite preview",
    "test": "vitest",
    "e2e": "pnpm exec playwright test",
    "setup:browser": "pnpm exec playwright install --with-deps",
    "setup:dev": "pnpm lefthook install"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.59.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/ui": "^4.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.6",
    "msw": "^2.14.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-svg-loader": "^5.1.1",
    "vitest": "^4.1.0"
  },
  "msw": {
    "workerDirectory": "public"
  }
}